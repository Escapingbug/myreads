{
  "name": "myreads",
  "version": "0.3.1",
  "androidVersionCode": 6,
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run sources:pack && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "native:sync": "npm run build && cap sync",
    "android": "cap open android",
    "android:build": "node scripts/build-android.mjs",
    "android:release": "node scripts/build-android.mjs --release",
    "release:prepare": "node scripts/prepare-release.mjs",
    "sources:pack": "node scripts/pack-sources.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.0",
    "linkedom": "^0.18.13",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^25.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  }
}
